  "private": true,
  "scripts": {
    "dev": "next dev",
    "verify:boundaries": "node scripts/verify-production-boundaries.mjs",
    "typecheck": "npm run verify:boundaries && tsc --noEmit",
    "prebuild": "prisma generate",
    "build": "npm run verify:boundaries && next build",
    "start": "next start",
    "lint": "eslint .",
    "db:generate": "prisma generate",
    "db:migrate": "prisma migrate dev",
    "db:seed": "tsx prisma/seed.ts",
    "db:studio": "prisma studio",
    "format": "prettier --write ."
  },
  "dependencies": {
    "@prisma/adapter-pg": "^7.10.0",
    "@prisma/client": "^7.10.0",
    "@supabase/ssr": "latest",
    "@supabase/supabase-js": "latest",
    "clsx": "latest",
    "lucide-react": "latest",
    "next": "^16.3.3",
    "openai": "^7.8.0",
    "pg": "latest",
    "react": "latest",
    "react-dom": "latest",
    "zod": "latest"
  },
"overrides": {
  "deepmerge-ts": "^8.0.0"
},
  "devDependencies": {
    "@tailwindcss/postcss": "latest",
    "@types/node": "latest",
    "@types/pg": "latest",
    "@types/react": "latest",
    "@types/react-dom": "latest",
    "autoprefixer": "latest",
    "dotenv": "latest",
    "eslint": "^9.39.4",
    "eslint-config-next": "^16.3.3",
    "postcss": "latest",
    "prettier": "latest",
    "prisma": "^7.10.0",
    "tailwindcss": "latest",
    "tsx": "latest",
    "typescript": "latest"
  },
  "prisma": {
    "seed": "tsx prisma/seed.ts"
  }
