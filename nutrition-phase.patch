+                }
+              >
+                Remove meal
+              </Button>
+            </div>
+          ))}
+          <Button
+            type="button"
+            variant="secondary"
+            disabled={baseline.meals.length >= 10}
+            onClick={() =>
+              setBaseline({
+                ...baseline,
+                meals: [
+                  ...baseline.meals,
+                  {
+                    id: crypto.randomUUID(),
